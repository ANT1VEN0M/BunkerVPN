<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_widget_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cyber_widget_inactive"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <!-- Cyber Cat Avatar -->
    <ImageView
        android:id="@+id/image_widget_logo"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/bunker_logo" />

    <!-- Center Info Column -->
    <LinearLayout
        android:id="@+id/layout_widget_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="⚪ БУНКЕР ОТКЛЮЧЕН"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_widget_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Узлы готовы к работе"
            android:textColor="#E2E8F0"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_widget_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="↓ 0 B/s  •  ↑ 0 B/s"
            android:textColor="#A78BFA"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Quick Toggle Button -->
    <FrameLayout
        android:id="@+id/layout_switch"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_cyber_button_inactive"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/image_switch"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play_24dp" />
    </FrameLayout>
</LinearLayout>
